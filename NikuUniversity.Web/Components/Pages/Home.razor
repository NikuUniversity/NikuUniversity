@page "/"

<PageTitle>Home - Niku University Dashboard</PageTitle>

<div class="row">
    <!-- Welcome Card -->
    <div class="col-lg-12 mb-4">
        <div class="card shadow-sm animate__animated animate__fadeInDown">
            <div class="card-header bg-gradient">
                <h3 class="card-title mb-0">
                    <i class="fas fa-graduation-cap me-2"></i> Welcome to Niku University
                </h3>
            </div>
            <div class="card-body">
                <p class="lead mb-3">Welcome to your modern, responsive university management dashboard.</p>
                <p>This application features a beautiful AdminLTE design with a professional layout. Use the navigation menu on the left to explore different sections of the application.</p>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <h5><i class="fas fa-star text-warning me-2"></i> Key Features</h5>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success me-2"></i> Responsive Design</li>
                            <li><i class="fas fa-check text-success me-2"></i> Modern UI/UX</li>
                            <li><i class="fas fa-check text-success me-2"></i> AdminLTE Integration</li>
                            <li><i class="fas fa-check text-success me-2"></i> Blazor Components</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5><i class="fas fa-rocket text-info me-2"></i> Interactive Pages</h5>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-calculator me-2"></i> <a href="/counter" class="text-decoration-none">Counter</a> - Interactive component demo</li>
                            <li><i class="fas fa-cloud me-2"></i> <a href="/weather" class="text-decoration-none">Weather</a> - Data display showcase</li>
                            <li><i class="fas fa-book me-2"></i> <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-decoration-none">Learn ASP.NET Core</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Stats Row -->
<div class="row">
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-text mb-0">Total Students</h6>
                        <h2 class="mb-0">2,547</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.3;">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-text mb-0">Active Courses</h6>
                        <h2 class="mb-0">84</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.3;">
                        <i class="fas fa-book-open"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-warning text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-text mb-0">Faculty Members</h6>
                        <h2 class="mb-0">156</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.3;">
                        <i class="fas fa-chalkboard-user"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-info text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-text mb-0">Departments</h6>
                        <h2 class="mb-0">12</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.3;">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Access Cards -->
<div class="row">
    <div class="col-lg-4 col-md-6 mb-4">
        <a href="/counter" class="card-link">
            <div class="card border-start border-4 border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calculator fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Counter Demo</h5>
                    <p class="card-text text-muted">Interactive component showcase</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <a href="/weather" class="card-link">
            <div class="card border-start border-4 border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-cloud fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Weather Data</h5>
                    <p class="card-text text-muted">API integration example</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <a href="https://github.com/NikuUniversity/NikuUniversity" target="_blank" class="card-link">
            <div class="card border-start border-4 border-secondary shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fab fa-github fa-3x text-secondary mb-3"></i>
                    <h5 class="card-title">GitHub Repository</h5>
                    <p class="card-text text-muted">View the source code</p>
                </div>
            </div>
        </a>
    </div>
</div>
